  "application_version": "1.0.0",
  "project": {
    "name": "Motor Current Analysis",
    "description": "Compare raw and filtered motor current in time and frequency domains.",
    "notes": "The low-pass filter suppresses broadband noise while retaining commutation ripple."
  },
  "nodes": [
    {
      "id": "import_motor",
      "type": "import_data",
      "position": [
        -780,
        -70
      ],
      "parameters": {
        "file_path": "motor_current.csv",
        "delimiter": ",",
        "header_row": 0,
        "skip_rows": 0,
        "sheet_name": "0",
        "time_column": "time_s",
        "signal_columns": "motor_current_a",
        "sample_rate": 2000.0,
        "signal_names": "Raw motor current",
        "units": "A",
        "time_mode": "seconds",
        "decimal": ".",
        "thousands": "",
        "missing_policy": "interpolate",
        "chunk_size": 250000
      }
    },
    {
      "id": "lp_motor",
      "type": "low_pass",
      "position": [
        -470,
        -90
      ],
      "parameters": {
        "cutoff": 350.0,
        "lower_cutoff": 5.0,
        "upper_cutoff": 20.0,
        "order": 5,
        "ripple": 1.0,
        "attenuation": 40.0,
        "zero_phase": true,
        "edge_padding": "odd"
      }
    },
    {
      "id": "scope_motor",
      "type": "scope",
      "position": [
        -120,
        -170
      ],
      "parameters": {
        "title": "Raw vs Filtered Motor Current",
        "max_display_points": 100000,
        "grid": true,
        "legend": true,
        "line_width": 1.3
      }
    },
    {
      "id": "fft_motor_raw",
      "type": "fft",
      "position": [
        -470,
        100
      ],
      "parameters": {
        "window": "hann",
        "detrend": true,
        "output": "magnitude"
      }
    },
    {
      "id": "fft_motor_filtered",
      "type": "fft",
      "position": [
        -130,
        100
      ],
      "parameters": {
        "window": "hann",
        "detrend": true,
        "output": "magnitude"
      }
    },
    {
      "id": "spectrum_motor_raw",
      "type": "spectrum_analyser",
      "position": [
        230,
